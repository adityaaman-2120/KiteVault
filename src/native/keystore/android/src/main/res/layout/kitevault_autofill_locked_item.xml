<?xml version="1.0" encoding="utf-8"?>
<!--
  The single suggestion shown in the autofill drop-down before the user has unlocked KiteVault.
  Its text is fixed on purpose: it never contains a web address, an account or any page text.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:text="Unlock KiteVault to fill"
    android:textSize="16sp"
    android:textStyle="bold" />
