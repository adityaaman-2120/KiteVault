<?xml version="1.0" encoding="utf-8"?>
<!--
  The single suggestion shown in the autofill drop-down before the user has unlocked KiteVault.
  Its text is fixed on purpose: it never contains a web address, an account or any page text.
  The colours are left to the system so it reads in both the light and the dark drop-down.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kitevault_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlock KiteVault to fill"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="Use your fingerprint or face"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
