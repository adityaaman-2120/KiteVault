{
  "expo": {
    "name": "KiteVault",
    "slug": "kitevault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitevault",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.kitelux.kitevault",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E1630",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1630",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KiteVault uses the camera only to scan a 2FA QR code. Nothing is recorded or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withNoBackup",
      "./plugins/withAutofill",
      "./plugins/withNoTelemetry",
      [
        "./plugins/withGoogleBackup",
        {
          "enabled": false,
          "webClientId": ""
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "cloudBackup": {
        "enabled": false,
        "webClientId": ""
      },
      "eas": {
        "projectId": "d0ac7ffc-556c-418a-80a0-7ab30f5fdd25"
      }
    }
  }
}
